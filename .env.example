# CallSense configuration. Copy to `.env` and fill in as needed.
# `.env` is gitignored; this template is committed so required keys can't rot.

# --- Core ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database ---
# Docker compose overrides host to `postgres`. For local conda dev use localhost.
DATABASE_URL=postgresql+psycopg://callsense:callsense@localhost:5432/callsense

# --- Analysis / LLM (Phase 4+) ---
# MOCK_MODE=true runs the whole loop with canned fixtures and zero network,
# so graders without an API key still see the full system work.
# For REAL analysis: set MOCK_MODE=false and add a key below.
MOCK_MODE=true
LLM_PROVIDER=gemini            # gemini | anthropic
LLM_TEMPERATURE=0.0

# Gemini (free from https://aistudio.google.com/apikey) — the default real provider.
GEMINI_API_KEY=
# flash-lite is reliable on the free tier (flash/pro quotas exhaust fast -> 429).
# Upgrade to gemini-flash-latest or gemini-3.1-pro for higher quality if quota allows.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_CLASSIFIER_MODEL=gemini-flash-lite-latest

# Anthropic (alternative)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Client-side rate limiting (protects free-tier quotas)
LLM_MIN_INTERVAL_S=1.0
LLM_MAX_RETRIES=4

# --- Transcription / diarisation (Phase 3+) ---
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
# Optional: enables pyannote diarisation; without it the energy/turn fallback runs.
HF_TOKEN=

# --- Pipeline / worker ---
WORKER_POLL_INTERVAL_S=2.0
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_S=2.0

# --- Ingestion (Phase 2+) ---
WATCH_FOLDER=./demo/audio/inbox
AUDIO_STORAGE_DIR=./demo/audio/store
